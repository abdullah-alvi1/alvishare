        },
        {
          "name": "Download one file",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/shares/{{key}}/download?file={{fileId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shares",
                "{{key}}",
                "download"
              ],
              "query": [
                {
                  "key": "file",
                  "value": "{{fileId}}"
