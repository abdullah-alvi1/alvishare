# ---- Server ----
PORT=3000
NODE_ENV=development
# Set when behind a reverse proxy (nginx etc). Number of proxies, or "false".
TRUST_PROXY=false
# Public URL used inside QR codes. Leave empty to auto-detect your LAN IP.
PUBLIC_URL=
CORS_ORIGIN=*

# ---- Uploads ----
MAX_FILE_SIZE_MB=500
MAX_FILES_PER_SHARE=10
MAX_STORAGE_GB=20
# comma separated, e.g. exe,bat,sh  (empty = allow all types)
BLOCKED_EXTENSIONS=

# ---- Shares / keys ----
KEY_LENGTH=6
DEFAULT_EXPIRY_MINUTES=30
MAX_EXPIRY_MINUTES=1440
# 0 = unlimited downloads
DEFAULT_MAX_DOWNLOADS=0
MAX_DOWNLOADS_CAP=100
CLEANUP_INTERVAL_SECONDS=60

# ---- Rate limits (per IP) ----
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_KEY_LOOKUP_PER_MIN=30

# ---- WebRTC / WebSocket ----
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
WS_MAX_CONNECTIONS_PER_IP=20
